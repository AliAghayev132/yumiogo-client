# Origin of the Yumio API (without the trailing /api).
#
# Leave EMPTY: the admin calls /api, /uploads and /socket.io on its own origin.
#  - production: nginx serves the site and proxies those paths to the API server;
#  - `npm run dev`: Vite proxies them to the local server (http://localhost:3042,
#    change with API_PROXY_TARGET=http://localhost:<port> npm run dev).
# Set it only to call an API on another origin directly (that server must allow CORS).
VITE_API_URL=
